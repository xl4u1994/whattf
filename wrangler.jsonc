{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whattf",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "db573311-2787-4be3-a13f-97439317295f","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4b0d340f75084e788b7ca3a4c14629cb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
